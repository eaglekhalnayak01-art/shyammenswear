# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored, so
# your secrets never reach GitHub.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (REQUIRED)
# Local:    postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Neon:     postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Signs admin + customer session cookies. Use a long random string.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-this-to-a-long-random-string

# Secret key needed to open the admin login page:
#   /admin/login?key=<this value>
ADMIN_ACCESS_KEY=smw-owner-7x2k9q

# Public site URL — used for SEO metadata and sitemap.xml
SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# OPTIONAL — WhatsApp Cloud API: enables new-order WhatsApp alerts to the
# shop number configured in Admin → Settings.
# ---------------------------------------------------------------------------
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Set to "sms" to switch on a real SMS OTP provider instead of demo OTP mode.
# OTP_PROVIDER=demo
